# Build artifacts (CMake, JUCE FetchContent, compiled binaries)
build/
out/

# ROM dumps must never be committed - they are copyrighted Roland firmware.
# (They live outside this repo anyway, but this is a safety net.)
*.bin
*.rom

# D-50 SysEx patch-bank dumps (d50/roms/) - somebody's own patch work, not ours to
# distribute, same reasoning as the ROM dumps above.
*.syx

# OS/editor cruft
.vs/
.vscode/
*.user
Thumbs.db
.DS_Store

# Python bytecode cache (d50/tools/*.py get run directly, not installed)
__pycache__/
*.pyc

# Local release-packaging zip files
*.zip

# Scanned Roland manuals used as measurement references. They are Roland's
# copyright, so they stay local - docs/sysex_address_map.md records where to get
# them and what was taken from them.
docs/manuals/

# MAME writes its own config/nvram next to whatever binary ran it.
plugin/Source/cfg/
cfg/
nvram/

# Build logs from scripts/*.bat
build_logs/

release-artifacts/
*.deb
*.exe

# Android app (android/): same idea as build/ above - JUCE is fetched fresh (by
# settings.gradle, matching the desktop CMake build's own FetchContent), never vendored.
android/juce-src/
android/local.properties
android/.gradle/
android/.idea/
android/.cxx/
android/app/build/
android/app/.cxx/

# claude
.claude
