 void roland_d10_state::d10_palette(palette_device &palette) const
 {
 	palette.set_pen_color(0, rgb_t(0, 255, 0));
@@ -255,8 +271,14 @@ void roland_d10_state::d10_bank_map(address_map &map)
 void roland_d10_state::d110_map(address_map &map)
 {
 	map(0x0100, 0x0100).w(FUNC(roland_d10_state::bank_w));
-	map(0x0200, 0x0200).w(FUNC(roland_d10_state::so_w));
-	map(0x021a, 0x021b).portr("SC0").nopw();
+	// The SO latch answers at 0x0280 as well, which is the same address bar A7. The
+	// firmware writes it three times while booting, from three different routines, and
+	// those are the writes that raise R.SW and select the reverb program: 2c and 0c
+	// decode under the bit assignment above as program 2 with R.SW set, where the two
+	// writes to 0x0200 are both zero. The board's own decoding was not traced, so the
+	// mirror is inferred from the values making sense rather than from the schematic.
+	map(0x0200, 0x0200).mirror(0x80).w(FUNC(roland_d10_state::so_w));
+	map(0x021a, 0x021b).portr("SC0").w(FUNC(roland_d10_state::sw_scan_w));
 	map(0x021c, 0x021d).portr("SC1");
 	map(0x0300, 0x0300).w(FUNC(roland_d10_state::lcd_data_w));
 	map(0x0380, 0x0380).rw(FUNC(roland_d10_state::lcd_ctrl_r), FUNC(roland_d10_state::lcd_ctrl_w));
